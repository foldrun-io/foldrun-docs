---
// The docs landing — public, indexable, and the same files the dashboard shows
// to people who have signed up.
//
// It sits in the docs shell rather than beside it, so the tree on the left is
// the same one every page has. What is left in the middle is the part an index
// should be: the fastest path to running something, then the map.
//
// The grouping is editorial and comes from the docs index (index.ts); the titles and
// summaries are read out of the markdown itself, so adding docs/foo.md puts a
// card here with no code change.

import Docs from "../layouts/Docs.astro";
import CodePanel from "@foldrun/ui/components/CodePanel.astro";
import Card from "@foldrun/ui/components/Card.astro";
import { getCollection } from "astro:content";
import { groupedDocs, docTitle, docSummary } from "../lib/docs.ts";

const entries = await getCollection("docs");
const bySlug = new Map(entries.map((e) => [e.id, e]));

const groups = groupedDocs()
  .map((g) => ({
    ...g,
    docs: g.slugs
      .filter((slug) => bySlug.has(slug))
      .map((slug) => {
        const raw = bySlug.get(slug)!.body ?? "";
        return { slug, title: docTitle(raw, slug), summary: docSummary(raw) };
      }),
  }))
  .filter((g) => g.docs.length);

// A heading id from a group title: lowercase words joined by hyphens.
const slugOf = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

const quickstart = `npm install -g foldrun

foldrun init my-workspace     # a workspace that already runs
foldrun check                 # validate everything — no model is called
foldrun run publish           # run it, locally, for real`;
---

<Docs
  title="Docs — foldrun"
  description="Agents are just folders and flows are numbered lists, so there is no build step: edit, check, run, deploy. Start on your own machine — none of it needs an account."
>
  <div class="max-w-3xl">
    <h1 class="t-display text-4xl sm:text-5xl">Documentation</h1>
    <p class="t-lead mt-5">
      Agents are just folders and flows are numbered lists, so there is no build
      step: edit, check, run, deploy. Start on your own machine — none of it
      needs an account.
    </p>

    <CodePanel class="mt-8" tabs={[{ id: "start", label: "Terminal", code: quickstart }]} title="Start on your machine" />

    {groups.map((group) => (
      <section class="mt-14" aria-labelledby={`group-${slugOf(group.title)}`}>
        <h2 id={`group-${slugOf(group.title)}`} class="text-xl font-semibold tracking-[-0.02em]">{group.title}</h2>
        <p class="mt-1.5 leading-relaxed text-fg-muted">{group.blurb}</p>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {group.docs.map((doc) => (
            <li class="min-w-0"><Card href={`/${doc.slug}/`} title={doc.title} body={doc.summary} /></li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Docs>
