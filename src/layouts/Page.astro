---
// Every page on the docs site: the shell foldrun.io uses too (@foldrun/ui
// BaseLayout, Header, Footer), with the docs' own links. One look across
// the two sites, one implementation: a change to the header is a change in
// the package, picked up by both.

import BaseLayout from "@foldrun/ui/layouts/BaseLayout.astro";
import Header from "@foldrun/ui/components/Header.astro";
import Footer from "@foldrun/ui/components/Footer.astro";
import { DOCS_URL, SITE_URL, signIn, signUp, SIGNUP_API, STATUS_API, CONTACT, NAV, FOOTER } from "../lib/site.ts";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description} siteUrl={DOCS_URL} signupApi={SIGNUP_API} signupUrl={signUp} pricingUrl={`${SITE_URL}/pricing/`}>
  <Header
    slot="header"
    suffix="docs"
    width="wide"
    nav={NAV}
    actions={[{ href: signIn, label: "Sign in", variant: "outline" }, { href: signUp, label: "Get started", signup: "primary" }]}
  />
  <slot />
  <Footer
    slot="footer"
    width="wide"
    columns={FOOTER}
    notes={[`© ${new Date().getFullYear()} foldrun`, "Built in Australia"]}
    contact={CONTACT}
    statusApi={STATUS_API}
    statusHref={`${SITE_URL}/status/`}
  />
</BaseLayout>
