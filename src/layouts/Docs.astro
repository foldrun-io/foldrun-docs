---
// The docs shell: a persistent index on the left, the prose in the middle, and
// where you are in the current page on the right.
//
// Docs are read by jumping, not by scrolling top to bottom. The old page was a
// single centered column, which meant every move between two documents went
// back through the index — and a long reference like flows.md had no way to
// see its own shape at all. The three columns are those two problems: the tree
// is always there, and so is the current page's outline.
//
// The nav is built from the same grouping the index and the dashboard use, so
// adding docs/foo.md puts it in the sidebar with no code change here.

import Page from "./Page.astro";
import Disclosure from "@foldrun/ui/components/Disclosure.astro";
import Icon from "@foldrun/ui/components/Icon.astro";
import DocsNav from "../components/DocsNav.astro";
import DocsToc from "../components/DocsToc.astro";
import PrevNext from "../components/PrevNext.astro";
import { groupedDocs, docTitle } from "../lib/docs.ts";
import { getCollection } from "astro:content";

interface Props {
  title: string;
  description: string;
  /** The doc being read, or undefined on the index. */
  slug?: string;
  /** Astro's own heading list, so the outline cannot disagree with the page. */
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, description, slug, headings = [] } = Astro.props;

const entries = await getCollection("docs");
const bySlug = new Map(entries.map((e) => [e.id, e]));
const groups = groupedDocs()
  .map((g) => ({
    ...g,
    docs: g.slugs
      .filter((s) => bySlug.has(s))
      .map((s) => ({ slug: s, title: docTitle(bySlug.get(s)!.body ?? "", s) })),
  }))
  .filter((g) => g.docs.length);

// Reading order is the sidebar's order, so "next" means the next thing a
// person would read rather than the next file alphabetically.
const flat = groups.flatMap((g) => g.docs);
const here = flat.findIndex((d) => d.slug === slug);
const prev = here > 0 ? flat[here - 1] : null;
const next = here >= 0 && here < flat.length - 1 ? flat[here + 1] : null;
const group = groups.find((g) => g.docs.some((d) => d.slug === slug));

// h2 and h3 only: h1 is the page title, and h4 down is detail the outline
// would turn into noise.
const outline = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Page title={title} description={description}>
  <div class="container-wide flex gap-10 py-10 lg:py-12">
    <!-- Left: every doc, always. Sticky below the header on wide screens; on
         phones a disclosure, where a permanent tree costs more room than it
         gives. -->
    <nav aria-label="Docs" class="hidden w-56 shrink-0 lg:block">
      <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto pb-8 pr-2">
        <DocsNav groups={groups} current={slug} />
      </div>
    </nav>

    <div class="min-w-0 flex-1">
      <Disclosure id="browse-docs" class="mb-8 rounded-xl border bg-surface lg:hidden" buttonClass="px-4 py-3 text-sm font-medium" panelClass="border-t px-4 pt-1 pb-4">
        <Fragment slot="summary">Browse docs <Icon name="chevron-down" class="size-4 text-fg-muted transition-transform group-aria-expanded:rotate-180" /></Fragment>
        <DocsNav groups={groups} current={slug} />
      </Disclosure>

      {slug && (
        <p class="mb-6 flex items-center gap-2 text-sm text-fg-muted">
          <a href="/" class="transition-colors hover:text-fg">Docs</a>
          {group && <Icon name="arrow-right" class="size-3 text-fg-subtle" />}
          {group && <span>{group.title}</span>}
        </p>
      )}

      <slot />

      <script>
        // Astro gives every heading an id; this turns each one into something
        // a reader can copy a link to.
        for (const h of document.querySelectorAll(".prose h2[id], .prose h3[id]")) {
          const a = document.createElement("a");
          a.className = "anchor";
          a.href = "#" + h.id;
          a.setAttribute("aria-label", "Link to this section");
          a.textContent = "#";
          h.prepend(a);
        }
      </script>

      <PrevNext prev={prev} next={next} />
    </div>

    <!-- Right: the current page's own shape. Only where there is room for it
         and something to show — a two-heading outline is a distraction. -->
    {outline.length > 2 && (
      <aside aria-label="On this page" class="hidden w-52 shrink-0 xl:block">
        <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto pb-8">
          <DocsToc headings={outline} />
        </div>
      </aside>
    )}
  </div>
</Page>
